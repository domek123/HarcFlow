generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ScoutYear {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  events    Event[]

  @@index([startDate, endDate])
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId   String?       @unique @db.Uuid

  email        String?       @unique
  phoneNumber  String?       @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  pesel        String?       @unique
  gender       Gender
  role         Role          @default(USER)
  createdAt      DateTime    @default(now())

  writtenNotes ScoutNote[]    @relation("NoteAuthor")
  scoutProfile ScoutProfile?
  parents      Parent[]       @relation("UserParents")
}

model Parent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  firstName   String
  lastName    String
  phoneNumber String?
  email       String?

  children    User[]   @relation("UserParents")
}

model ScoutProfile {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @unique @db.Uuid
  troopId        String       @db.Uuid
  patrolId       String?      @db.Uuid

  rank           Rank         @default(NONE)
  degree         Degree       @default(NONE)
  function       Function     @default(NONE)
  acquiringDegree Degree      @default(NONE)
  hasNaramiennik Boolean      @default(false)

  joinedAt       DateTime?
  isActive       Boolean        @default(true)

  notes          ScoutNote[]  @relation("ProfileNotes")
  patrol         ScoutPatrol? @relation(fields: [patrolId], references: [id])
  troops         ScoutTroop   @relation(fields: [troopId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges         UserBadge[]
  attendances Attendance[]
  scoutDegrees ScoutDegree[]

  @@index([troopId])
  @@index([patrolId])
  @@index([function])
  @@index([troopId, patrolId])

}

model UserBadge {
  profileId String       @db.Uuid
  badgeId   String       

  status    BadgeStatus  @default(PLANNED)
  updatedAt DateTime     @default(now()) @updatedAt     

  profile   ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, badgeId])
  @@index([profileId, status])
}

model ScoutNote {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String       @db.Uuid
  profileId String       @db.Uuid

  content   String
  createdAt DateTime     @default(now())

  author    User         @relation("NoteAuthor", fields: [authorId], references: [id])
  profile   ScoutProfile @relation("ProfileNotes", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
}

model ScoutTroop {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  name           String
  description    String?

  badgeInventory BadgeStore[]
  troopInventory InventoryItem[]
  patrols        ScoutPatrol[]
  members        ScoutProfile[]
  events Event[]
  degreeTemplates DegreeTemplate[]
}

model ScoutPatrol {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  troopId      String         @db.Uuid

  name         String         
  assemblyDay  Int?
  assemblyTime String?

  troop        ScoutTroop     @relation(fields: [troopId], references: [id])
  members      ScoutProfile[]

  @@unique([troopId, name])
  @@index([troopId])
}

model BadgeStore {
  troopId String     @db.Uuid
  badgeId String    

  quantity  Int        @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  troop   ScoutTroop @relation(fields: [troopId], references: [id])

  @@id([troopId, badgeId])
}

model InventoryItem {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  troopId String            @db.Uuid

  name    String
  amount  Int
  type    InventoryItemType

  troop   ScoutTroop        @relation(fields: [troopId], references: [id])
}

model Event {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  troopId        String       @db.Uuid
  scoutYearId     String      @db.Uuid

  title          String
  description    String?
  startDate      DateTime     @db.Timestamptz
  endDate        DateTime     @db.Timestamptz
  location       String?
  createdAt      DateTime    @default(now()) @db.Timestamptz

  troop        ScoutTroop        @relation(fields: [troopId], references: [id], onDelete: Cascade)
  scoutYear     ScoutYear @relation(fields: [scoutYearId],references: [id],onDelete: Restrict)
  attendances  Attendance[]

  @@index([troopId, scoutYearId, startDate])
}

model Attendance {
  eventId   String           @db.Uuid
  scoutId  String           @db.Uuid

  status    AttendanceStatus
  updatedAt DateTime        @default(now()) @updatedAt @db.Timestamptz

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scout ScoutProfile @relation(fields: [scoutId], references: [id], onDelete: Cascade)

  @@id([eventId, scoutId])
}

model DegreeTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  troopId     String   @db.Uuid

  degree      Degree
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  troop       ScoutTroop @relation(fields: [troopId], references: [id], onDelete: Cascade)
  tasks       DegreeTemplateTask[]
  scoutDegrees ScoutDegree[]
  
  @@unique([troopId,degree])
  @@index([isActive])
}

model DegreeTemplateTask {
  id          String   @id @default(uuid()) @db.Uuid
  templateId    String   @db.Uuid

  description String?
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  template      DegreeTemplate @relation(fields: [templateId],references: [id],onDelete: Cascade)

  @@index([templateId])
}

model ScoutDegree {
  id          String   @id @default(uuid()) @db.Uuid
  scoutId     String   @db.Uuid
  degreeId    String   @db.Uuid

  status      ScoutDegreeStatus @default(PREPARED)
  startedAt   DateTime?
  completedAt DateTime?
  orderNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scout       ScoutProfile  @relation(fields: [scoutId],references: [id],onDelete: Cascade)
  degree      DegreeTemplate @relation(fields: [degreeId],references: [id])
  tasks       ScoutDegreeTask[]

  @@unique([scoutId, degreeId])
  @@index([scoutId])
  @@index([degreeId])
}

model ScoutDegreeTask {
  id            String   @id @default(uuid()) @db.Uuid
  scoutDegreeId String   @db.Uuid

  description String?
  position    Int
  source      ScoutDegreeTaskSource
  status      ScoutDegreeTaskStatus @default(TODO)

  scoutDegree ScoutDegree @relation(fields: [scoutDegreeId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 

  @@index([scoutDegreeId])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum BadgeStatus {
  PLANNED
  COMPLETED
  WON
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  ADMIN
}

enum Function {
  DRUZYNOWY
  PRZYBOCZNY
  ZASTEPOWY
  PODZASTEPOWY
  NONE
}

enum Rank {
  HARCMISTRZ
  PODHARCMISTRZ
  PRZEWODNIK
  NONE
}

enum Degree {
  HR
  HO
  CW
  WYW
  ML
  DH
  NONE
}

enum InventoryItemType {
  UNIFORM
  EQUIPMENT
}

enum ScoutDegreeStatus {
  PREPARED
  IN_PROGRESS
  COMPLETED
}

enum ScoutDegreeTaskStatus {
  TODO
  SUBMITTED
  APPROVED
}

enum ScoutDegreeTaskSource {
  TEMPLATE
  INDIVIDUAL
}