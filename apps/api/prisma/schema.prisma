generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String?       @unique
  phoneNumber  String?       @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  pesel        String?       @unique
  gender       Gender
  role         Role          @default(USER)
  notes        ScoutNote[]
  scoutProfile ScoutProfile?
  parents      Parent[]      @relation("UserParents")
}

model Parent {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  phoneNumber String
  email       String?
  children    User[]  @relation("UserParents")
}

model ScoutProfile {
  id             String       @id @default(uuid())
  userId         String       @unique
  rank           Rank         @default(NONE)
  degree         Degree       @default(NONE)
  function       Function     @default(NONE)
  hasNaramiennik Boolean      @default(false)
  troopId        String
  patrolId       String?
  notes          ScoutNote[]
  patrol         ScoutPatrol? @relation(fields: [patrolId], references: [id])
  troops         ScoutTroop   @relation(fields: [troopId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges         UserBadge[]
}

model UserBadge {
  profileId String
  badgeId   String
  status    BadgeStatus  @default(PLANNED)
  openedAt  DateTime?
  wonAt     DateTime?
  badge     MeritBadge   @relation(fields: [badgeId], references: [id])
  profile   ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, badgeId])
}

model ScoutNote {
  id        String       @id @default(uuid())
  content   String
  createdAt DateTime     @default(now())
  authorId  String
  profileId String
  author    User         @relation(fields: [authorId], references: [id])
  profile   ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model ScoutTroop {
  id             String          @id @default(dbgenerated("gen_random_uuid()"))
  name           String
  description    String?
  creationYear   Int?
  badgeInventory BadgesStore[]
  troopInventory InventoryItem[]
  patrols        ScoutPatrol[]
  members        ScoutProfile[]
}

model ScoutPatrol {
  id           String         @id @default(uuid())
  name         String
  assemblyDay  Int
  assemblyTime String
  troopId      String
  troop        ScoutTroop     @relation(fields: [troopId], references: [id])
  members      ScoutProfile[]
}

model BadgesStore {
  troopId String
  badgeId String
  amount  Int        @default(0)
  badge   MeritBadge @relation(fields: [badgeId], references: [id])
  troop   ScoutTroop @relation(fields: [troopId], references: [id])

  @@id([troopId, badgeId])
}

model MeritBadge {
  id         String        @id @default(uuid())
  name       String
  level      Int
  stock      BadgesStore[]
  achievedBy UserBadge[]
}

model InventoryItem {
  id      String            @id @default(uuid())
  name    String
  amount  Int
  troopId String
  type    InventoryItemType
  troop   ScoutTroop        @relation(fields: [troopId], references: [id])
}

enum BadgeStatus {
  PLANNED
  OPENED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  ADMIN
}

enum Function {
  DRUZYNOWY
  PRZYBOCZNY
  ZASTEPOWY
  PODZASTEPOWY
  NONE
}

enum Rank {
  HARCMISTRZ
  PODHARCMISTRZ
  PRZEWODNIK
  NONE
}

enum Degree {
  HR
  HO
  CW
  WYW
  ML
  DH
  NONE
}

enum InventoryItemType {
  UNIFORM
  EQUIPMENT
}
