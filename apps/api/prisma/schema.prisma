generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(uuid())
  email       String?   @unique
  phoneNumber String?   @unique
  firstName   String
  lastName    String
  birthDate   DateTime?
  pesel       String?   @unique
  gender      Gender
  role        Role      @default(USER)

  scoutProfile ScoutProfile?
  parents      Parent[]      @relation("UserParents")
  notes        ScoutNote[]
}

model Parent {
  id          String  @id @default(uuid())
  firstName   String
  lastName    String
  phoneNumber String
  email       String?

  children User[] @relation("UserParents")
}

// DANE HARCERSKIE
model ScoutProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  rank           Rank     @default(NONE)
  degree         Degree   @default(NONE)
  function       Function @default(NONE)
  hasNaramiennik Boolean  @default(false)
  troopId        String
  patrolId       String?

  troops ScoutTroop   @relation(fields: [troopId], references: [id])
  patrol ScoutPatrol? @relation(fields: [patrolId], references: [id])
  badges UserBadge[]
  notes  ScoutNote[]
}

// HISTORIA I STATUS SPRAWNOŚCI
model UserBadge {
  profileId String
  badgeId   String
  status    BadgeStatus @default(PLANNED)

  openedAt DateTime?
  wonAt    DateTime?

  profile ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badge   MeritBadge   @relation(fields: [badgeId], references: [id])

  @@id([profileId, badgeId])
}

model ScoutNote {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  profileId String
  profile   ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

// ORGANIZACJA (Drużyny/Zastępy)
model ScoutTroop {
  id           String  @id @default(uuid())
  name         String
  description  String?
  creationYear Int?

  patrols        ScoutPatrol[]
  members        ScoutProfile[]
  badgeInventory BadgesStore[]
  troopInventory InventoryItem[]
}

model ScoutPatrol {
  id           String @id @default(uuid())
  name         String
  assemblyDay  Int //1-7
  assemblyTime String //18:30

  troopId String
  troop   ScoutTroop @relation(fields: [troopId], references: [id])

  members ScoutProfile[]
}

// MAGAZYN (Fizyczne plakietki w szafie drużyny)
model BadgesStore {
  troopId String
  badgeId String
  amount  Int    @default(0)

  troop ScoutTroop @relation(fields: [troopId], references: [id])
  badge MeritBadge @relation(fields: [badgeId], references: [id])

  @@id([troopId, badgeId])
}

model MeritBadge {
  id    String @id @default(uuid())
  name  String
  level Int

  stock      BadgesStore[]
  achievedBy UserBadge[]
}

model InventoryItem {
  id      String            @id @default(uuid())
  name    String
  amount  Int
  troopId String
  type    InventoryItemType

  troop ScoutTroop @relation(fields: [troopId], references: [id])
}

enum BadgeStatus {
  PLANNED
  OPENED
  CLOSED
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  ADMIN
}

enum Function {
  DRUZYNOWY
  PRZYBOCZNY
  ZASTEPOWY
  PODZASTEPOWY
  NONE
}

enum Rank {
  HARCMISTRZ
  PODHARCMISTRZ
  PRZEWODNIK
  NONE
}

enum Degree {
  HR
  HO
  CW
  WYW
  ML
  DH
  NONE
}

enum InventoryItemType {
  UNIFORM
  EQUIPMENT
}
