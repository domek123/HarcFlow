generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String?       @unique
  phoneNumber  String?       @unique
  firstName    String
  lastName     String
  birthDate    DateTime?
  pesel        String?       @unique
  gender       Gender
  role         Role          @default(USER)

  writtenNotes ScoutNote[]    @relation("NoteAuthor")
  scoutProfile ScoutProfile?
  parents      Parent[]       @relation("UserParents")
}

model Parent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName   String
  lastName    String
  phoneNumber String?
  email       String?
  children    User[]   @relation("UserParents")
}

model ScoutProfile {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @unique @db.Uuid
  rank           Rank         @default(NONE)
  degree         Degree       @default(NONE)
  function       Function     @default(NONE)
  hasNaramiennik Boolean      @default(false)
  troopId        String       @db.Uuid
  patrolId       String?      @db.Uuid

  notes          ScoutNote[]  @relation("ProfileNotes")
  patrol         ScoutPatrol? @relation(fields: [patrolId], references: [id])
  troops         ScoutTroop   @relation(fields: [troopId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  badges         UserBadge[]

  @@index([troopId])
  @@index([patrolId])
  @@index([function])
  @@index([troopId, patrolId])
}

model UserBadge {
  profileId String       @db.Uuid
  badgeId   String       
  status    BadgeStatus  @default(PLANNED)
  profile   ScoutProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, badgeId])
  @@index([profileId, status])
}

model ScoutNote {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content   String
  createdAt DateTime     @default(now())
  authorId  String       @db.Uuid
  profileId String       @db.Uuid

  author    User         @relation("NoteAuthor", fields: [authorId], references: [id])
  profile   ScoutProfile @relation("ProfileNotes", fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt(sort: Desc)])
}

model ScoutTroop {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  description    String?
  creationYear   Int?
  badgeInventory BadgeStore[]
  troopInventory InventoryItem[]
  patrols        ScoutPatrol[]
  members        ScoutProfile[]
}

model ScoutPatrol {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String         @unique
  assemblyDay  Int?
  assemblyTime String?
  troopId      String         @db.Uuid

  troop        ScoutTroop     @relation(fields: [troopId], references: [id])
  members      ScoutProfile[]

  @@index([troopId])
}

model BadgeStore {
  troopId String     @db.Uuid
  badgeId String     
  quantity  Int        @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  troop   ScoutTroop @relation(fields: [troopId], references: [id])

  @@id([troopId, badgeId])
}

model InventoryItem {
  id      String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  amount  Int
  troopId String            @db.Uuid
  type    InventoryItemType
  troop   ScoutTroop        @relation(fields: [troopId], references: [id])
}

enum BadgeStatus {
  PLANNED     // Planowana
  IN_PROGRESS // Otwarta / W trakcie zdobywania
  COMPLETED   // Zdobyta (zaliczone wonAt)
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  USER
  ADMIN
}

enum Function {
  DRUZYNOWY
  PRZYBOCZNY
  ZASTEPOWY
  PODZASTEPOWY
  NONE
}

enum Rank {
  HARCMISTRZ
  PODHARCMISTRZ
  PRZEWODNIK
  NONE
}

enum Degree {
  HR
  HO
  CW
  WYW
  ML
  DH
  NONE
}

enum InventoryItemType {
  UNIFORM
  EQUIPMENT
}