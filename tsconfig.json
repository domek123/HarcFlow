{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@harcapp/types": ["./packages/types/src/index.ts"],
      "@harcapp/api-client": ["./packages/api-client/src/index.ts"],
      "@harcapp/validators": ["./packages/validators/src/index.ts"]
    },
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "jsx": "react"
  }
}
